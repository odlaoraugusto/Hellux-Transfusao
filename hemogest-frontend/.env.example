# Hellux — Variáveis de ambiente do frontend (copiar para .env e preencher)

# URL base da API (deixe em branco para usar o proxy padrão "/api/v1")
VITE_API_BASE_URL=

# --- Identidade institucional ---
# Nome e logo exibidos no cabeçalho, barra lateral, relatórios, Folha de
# Hemotransfusão e no PDF da Solicitação de Transfusão desta unidade
# hospitalar. Sem essas variáveis, a interface mostra um rótulo de texto
# genérico ("Unidade Hospitalar") em vez de assumir uma instituição real.
#
# VITE_INSTITUICAO_PRIMARIA_LOGO_URL deve apontar para uma imagem acessível
# publicamente pelo navegador (ex.: um arquivo em hemogest-frontend/public/
# ou uma URL absoluta) — para aparecer também no PDF gerado (gerarPdfSolicitacao.ts),
# o arquivo precisa ser PNG.
VITE_INSTITUICAO_PRIMARIA_NOME="Unidade Hospitalar"
VITE_INSTITUICAO_PRIMARIA_LOGO_URL=

# Instituição parceira/co-mantenedora (opcional) — ex.: uma fundação estatal
# de saúde responsável pela gestão da unidade. Deixe em branco se não houver.
VITE_INSTITUICAO_SECUNDARIA_NOME=
VITE_INSTITUICAO_SECUNDARIA_LOGO_URL=
