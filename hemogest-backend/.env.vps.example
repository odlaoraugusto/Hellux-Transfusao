# HemoGest — variáveis de ambiente para o deploy na VPS (docker-compose.vps.yml).
# Copie para hemogest-backend/.env DENTRO DA VPS e preencha com valores reais.
# NUNCA commite o .env real — este arquivo é só o modelo.

APP_NAME="Hellux - Módulo de Transfusão"
APP_ENV=production
APP_DEBUG=false

# Segurança — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Criptografia de campo (dados de paciente) — gere com:
# python scripts/generate_encryption_key.py
# NUNCA reaproveitar a mesma chave de outro ambiente (dev, Fly, etc.).
FIELD_ENCRYPTION_KEY=

# Banco — usuário/banco dedicados "hemogest" no Postgres compartilhado da
# VPS (container "postgres" na rede "backend", nunca exposto à internet).
DATABASE_URL=postgresql+psycopg://hemogest:SENHA_AQUI@postgres:5432/hemogest
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS — domínio do frontend nesta VPS (sslip.io, sem custo de domínio próprio)
CORS_ORIGINS=["https://hemogest.169-58-217-209.sslip.io"]

# Armazenamento de anexos — disco local, num volume Docker persistente
# (ver "hemogest_storage" no docker-compose.vps.yml). Só funciona com 1
# réplica do backend, que é o caso aqui.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
LOCAL_STORAGE_URL_TTL_MINUTES=15

LOG_LEVEL=INFO
LOG_JSON=true
