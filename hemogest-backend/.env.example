# HemoGest — Variáveis de ambiente (copiar para .env e preencher)

APP_NAME=HemoGest
APP_ENV=development
APP_DEBUG=true

# Segurança
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de Dados
DATABASE_URL=postgresql+psycopg://hemogest:hemogest@db:5432/hemogest
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=hemogest
MINIO_SECRET_KEY=troque-esta-chave-em-producao
MINIO_BUCKET_NAME=hemogest-anexos
MINIO_SECURE=false

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
